            background: #0d0f14;
            color: #f0f2f8;
            font-size: 16px;
            line-height: 1.6;
            -webkit-tap-highlight-color: transparent;
            overscroll-behavior: none;
        }
        .font-heading { font-family: 'Sora', sans-serif; }
        .font-chinese { font-family: 'Noto Sans SC', sans-serif; }
        .max-app { max-width: 480px; margin: 0 auto; }
        .card { background: #161a23; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.4); }
        .card-sm { background: #161a23; border-radius: 12px; }
        .btn-primary { background: #4f8ef7; color: white; border-radius: 12px; padding: 12px 24px; font-weight: 600; transition: all 0.2s; }
        .btn-primary:active { transform: scale(0.95); }
        .progress-bar { height: 4px; border-radius: 999px; background: #252b38; overflow: hidden; }
        .progress-fill { height: 100%; border-radius: 999px; transition: width 0.6s ease; }
        .bottom-nav { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 480px; background: #161a23; border-top: 1px solid #252b38; height: 60px; padding-bottom: env(safe-area-inset-bottom); z-index: 50; display: flex; justify-content: space-around; align-items: center; }
        .pulse-ring { animation: pulse 1.5s infinite; }
        @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(79, 142, 247, 0.4); } 70% { box-shadow: 0 0 0 12px rgba(79, 142, 247, 0); } 100% { box-shadow: 0 0 0 0 rgba(79, 142, 247, 0); } }
        .slide-up { animation: slideUp 0.3s ease; }
        @keyframes slideUp { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .fade-in { animation: fadeIn 0.3s ease; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        .waveform-bar { display: inline-block; width: 3px; background: #34d399; border-radius: 2px; animation: wave 0.8s infinite; }
        .waveform-bar:nth-child(1) { height: 8px; animation-delay: 0s; }
        .waveform-bar:nth-child(2) { height: 16px; animation-delay: 0.1s; }
        .waveform-bar:nth-child(3) { height: 12px; animation-delay: 0.2s; }
        .waveform-bar:nth-child(4) { height: 14px; animation-delay: 0.3s; }
        .waveform-bar:nth-child(5) { height: 6px; animation-delay: 0.4s; }
        @keyframes wave { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(0.4); } }
        .mic-pulse { animation: micPulse 1.2s infinite; }
        @keyframes micPulse { 0% { box-shadow: 0 0 0 0 rgba(79, 142, 247, 0.6); } 70% { box-shadow: 0 0 0 20px rgba(79, 142, 247, 0); } 100% { box-shadow: 0 0 0 0 rgba(79, 142, 247, 0); } }
        input, textarea { outline: none; }
        input:focus, textarea:focus { border-color: #4f8ef7 !important; }
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: #0d0f14; }
        ::-webkit-scrollbar-thumb { background: #252b38; border-radius: 2px; }
    </style>
</head>
